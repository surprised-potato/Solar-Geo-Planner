rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: {projectId} (string, 1 to 128 characters)
    // Fields:
    //   - id: string (required, matches {projectId}, immutable)
    //   - ownerUid: string (required, Firebase Auth uid of the creator, immutable)
    //   - memberEmails: list<string> (optional, <= 50 lower-case emails the owner shared with)
    //   - name: string (required, <= 500 chars)
    //   - createdAt / updatedAt: ISO string, timestamp or epoch millis (required)
    //   - dataJson: string (required, serialized project JSON <= 1,000,000 chars)
    //   - zoneCount, totalKwp: number >= 0 (optional)
    //   - description: string <= 1000 (optional), version: string <= 50 (optional)
    //
    // Access Control:
    //   - Every request requires Firebase Authentication (Google sign-in).
    //   - Projects are private to their owner. The owner can share a project with
    //     specific Google accounts by listing their (verified) emails in memberEmails.
    //   - Members can read and edit project content, but only the owner can change
    //     sharing (memberEmails) or delete the project. ownerUid and id never change.
    //   - Default deny for every other path.
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function isMember(data) {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in data.get('memberEmails', []);
    }

    function canAccess(data) {
      return isOwner(data) || isMember(data);
    }

    function isValidDateOrTimestamp(val) {
      return (val is string && val.size() >= 10 && val.size() <= 100) ||
             val is timestamp ||
             (val is number && val > 0);
    }

    function isValidProject(data, projectId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'createdAt', 'updatedAt', 'dataJson']) &&
             data.keys().hasOnly(['id', 'ownerUid', 'memberEmails', 'name', 'createdAt', 'updatedAt', 'dataJson', 'zoneCount', 'totalKwp', 'description', 'version']) &&
             data.id is string &&
             data.id == projectId &&
             data.id.size() >= 1 &&
             data.id.size() <= 128 &&
             data.ownerUid is string &&
             data.name is string &&
             data.name.size() <= 500 &&
             isValidDateOrTimestamp(data.createdAt) &&
             isValidDateOrTimestamp(data.updatedAt) &&
             data.dataJson is string &&
             data.dataJson.size() <= 1000000 &&
             (!('memberEmails' in data) || (data.memberEmails is list && data.memberEmails.size() <= 50)) &&
             (!('zoneCount' in data) || (data.zoneCount is number && data.zoneCount >= 0)) &&
             (!('totalKwp' in data) || (data.totalKwp is number && data.totalKwp >= 0)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('version' in data) || (data.version is string && data.version.size() <= 50));
    }

    match /projects/{projectId} {
      // Reading a not-yet-created ID is allowed so a client can check before creating it.
      allow get: if signedIn() && (resource == null || canAccess(resource.data));
      // Lists must be constrained to ownerUid == uid or memberEmails array-contains email.
      allow list: if canAccess(resource.data);

      allow create: if signedIn()
        && isValidProject(request.resource.data, projectId)
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if canAccess(resource.data)
        && isValidProject(request.resource.data, projectId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (isOwner(resource.data)
            || request.resource.data.get('memberEmails', []) == resource.data.get('memberEmails', []));

      allow delete: if isOwner(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
